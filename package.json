{
  "name": "nyoura-assistant",
  "version": "0.1.0",
  "description": "Voice AI assistant powered by Gemini Live",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yankelperelman/nyoura-assistant.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "socks-proxy-agent": "^8.0.4",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.nyoura.assistant",
    "productName": "Nyoura Assistant",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.md",
      "!.gitignore",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nyoura Assistant"
    },
    "publish": {
      "provider": "github",
      "owner": "yankelperelman",
      "repo": "nyoura-assistant"
    }
  }
}